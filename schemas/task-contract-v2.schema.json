{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ardguard.dev/schemas/task-contract-v2.schema.json",
  "title": "ARDGuard TaskContract v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "requirements"],
  "properties": {
    "schema_version": {"const": "ardguard.dev/task-contract/v2"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "operation": {"type": ["string", "null"], "minLength": 1},
    "context": {"type": "object", "not": {"required": ["eligible"]}},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "requirement_type", "parameters"],
        "properties": {
          "requirement_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "requirement_type": {"type": "string", "pattern": "^[a-z][a-z0-9_.:/-]{0,199}$"},
          "parameters": {"type": "object"},
          "mode": {"enum": ["MANDATORY", "ADVISORY"]},
          "unknown_policy": {"enum": ["INDETERMINATE", "UNSATISFIED", "ERROR"]},
          "namespace": {"type": ["string", "null"], "minLength": 1},
          "schema_identity": {"type": ["string", "null"], "minLength": 1}
        }
      }
    }
  }
}
